model Article {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  authorId    String
  author      User              @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  title       String
  slug        String
  excerpt     String?           @db.Text
  coverImage  Json?
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accessType  ProductAccessType @default(FREE)
  price       Decimal?          @db.Decimal(12, 2)
  currency    String            @default("IDR")
  status      ContentStatus     @default(DRAFT)
  publishedVersionId String?    @unique
  publishedVersion   ArticleVersion? @relation("ArticlePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  publishedAt DateTime?
  submittedAt DateTime?
  reviewedById String?
  reviewedBy  User?             @relation("ArticleReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt  DateTime?
  reviewNote  String?           @db.Text

  versions     ArticleVersion[] @relation("ArticleVersions")
  orderItems   OrderItem[]
  entitlements Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@index([status, submittedAt])
  @@index([authorId, status])
  @@index([categoryId])
}

model ArticleVersion {
  id            String    @id @default(uuid())
  articleId     String
  article       Article   @relation("ArticleVersions", fields: [articleId], references: [id], onDelete: Restrict)
  versionNumber Int
  title         String
  content       String    @db.Text
  changeReason  String?
  createdById   String
  createdBy     User      @relation("ArticleVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  publishedFor Article? @relation("ArticlePublishedVersion")

  @@unique([articleId, versionNumber])
  @@index([articleId, createdAt])
}

model ClassProduct {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instructorId    String
  instructor      User              @relation("ClassInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  title           String
  slug            String
  description     String?           @db.Text
  coverImage      Json?
  accessType      ProductAccessType @default(FREE)
  price           Decimal?          @db.Decimal(12, 2)
  currency        String            @default("IDR")
  format          ClassFormat       @default(LIVE)
  difficulty      ClassDifficulty   @default(BEGINNER)
  durationMinutes Int?
  capacity        Int?
  status          ContentStatus     @default(DRAFT)
  publishedAt     DateTime?
  submittedAt     DateTime?
  reviewedById    String?
  reviewedBy      User?             @relation("ClassReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?
  reviewNote      String?           @db.Text

  sessions     ClassSession[]
  enrollments  ClassEnrollment[]
  orderItems   OrderItem[]
  entitlements Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@index([instructorId, status])
}

model ClassSession {
  id             String             @id @default(uuid())
  classProductId String
  classProduct   ClassProduct       @relation(fields: [classProductId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  meetingUrl     String?
  recordingUrl   String?
  capacity       Int?
  status         ClassSessionStatus @default(SCHEDULED)

  attendances ClassAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classProductId, startsAt])
}

model ClassAttendance {
  id         String       @id @default(uuid())
  sessionId  String
  session    ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendedAt DateTime     @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

model ClassEnrollment {
  id             String           @id @default(uuid())
  classProductId String
  classProduct   ClassProduct     @relation(fields: [classProductId], references: [id], onDelete: Restrict)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?

  @@unique([classProductId, userId])
  @@index([userId, status])
}

model OrderItem {
  id         String        @id @default(uuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  articleId  String?
  article    Article?      @relation(fields: [articleId], references: [id], onDelete: Restrict)
  classId    String?
  classProduct ClassProduct? @relation(fields: [classId], references: [id], onDelete: Restrict)
  topicId    String?
  topic      Topic?        @relation(fields: [topicId], references: [id], onDelete: Restrict)
  quantity   Int           @default(1)
  unitPrice  Decimal       @db.Decimal(12, 2)
  totalPrice Decimal       @db.Decimal(12, 2)
  platformFee Decimal      @default(0) @db.Decimal(12, 2)

  earning CreatorEarning?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([articleId])
  @@index([classId])
  @@index([topicId])
  @@index([tenantId])
}

model Entitlement {
  id           String                  @id @default(uuid())
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  resourceType EntitlementResourceType
  articleId    String?
  article      Article?                @relation(fields: [articleId], references: [id], onDelete: Restrict)
  classId      String?
  classProduct ClassProduct?           @relation(fields: [classId], references: [id], onDelete: Restrict)
  topicId      String?
  topic        Topic?                  @relation(fields: [topicId], references: [id], onDelete: Restrict)
  orderId      String?
  order        Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status       EntitlementStatus       @default(ACTIVE)
  startsAt     DateTime                @default(now())
  expiresAt    DateTime?
  createdAt    DateTime                @default(now())

  @@unique([userId, articleId])
  @@unique([userId, classId])
  @@unique([userId, topicId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@index([orderId])
}

model ManualPaymentSubmission {
  id              String              @id @default(uuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntentId String
  paymentIntent   PaymentIntent       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  payerId         String
  payer           User                @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Restrict)
  paymentMethod   String
  amount          Decimal             @db.Decimal(12, 2)
  referenceNumber String?
  proofUrl        Json
  note            String?             @db.Text
  status          ManualPaymentStatus @default(SUBMITTED)
  submittedAt     DateTime            @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?             @db.Text

  @@index([orderId])
  @@index([paymentIntentId, status])
  @@index([status, submittedAt])
  @@index([payerId, status])
}

enum PaymentProvider {
  MANUAL
  STRIPE
  MIDTRANS
  XENDIT
  OTHER
}

enum PaymentIntentStatus {
  CREATED
  PENDING
  SUBMITTED
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentTransactionType {
  AUTHORIZATION
  CAPTURE
  SETTLEMENT
  REFUND
  REVERSAL
  ADJUSTMENT
}

enum PaymentTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PaymentIntent {
  id                String              @id @default(uuid())
  orderId           String
  order             Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider     @default(MANUAL)
  providerPaymentId String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("IDR")
  status            PaymentIntentStatus @default(CREATED)
  expiresAt         DateTime
  metadata          Json?
  paidAt            DateTime?

  transactions      PaymentTransaction[]
  manualSubmissions ManualPaymentSubmission[]
  refunds           Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
  @@index([status, expiresAt])
}

model PaymentTransaction {
  id                    String                   @id @default(uuid())
  paymentIntentId       String
  paymentIntent         PaymentIntent            @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  type                  PaymentTransactionType
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @default("IDR")
  externalReference     String?
  providerTransactionId String?
  status                PaymentTransactionStatus @default(SUCCEEDED)
  rawReference          Json?
  createdAt             DateTime                 @default(now())

  @@unique([paymentIntentId, type, providerTransactionId])
  @@index([paymentIntentId, createdAt])
}

model DomainEvent {
  id            String   @id @default(uuid())
  type          String
  aggregateType String
  aggregateId   String
  dedupeKey     String   @unique
  payload       Json
  tenantId      String?
  actorId       String?
  traceId       String?
  occurredAt    DateTime @default(now())

  @@index([type, occurredAt])
  @@index([aggregateType, aggregateId])
}

model CreatorEarning {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creatorId     String
  creator       User          @relation("EarningCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId   String        @unique
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  grossAmount   Decimal       @db.Decimal(12, 2)
  platformFee   Decimal       @db.Decimal(12, 2)
  creatorAmount Decimal       @db.Decimal(12, 2)
  currency      String        @default("IDR")
  status        EarningStatus @default(PENDING)
  releasedAt    DateTime?
  createdAt     DateTime      @default(now())

  ledger LedgerTransaction[]

  @@index([tenantId, status])
  @@index([creatorId, status])
  @@index([orderId])
}

model Wallet {
  id       String   @id @default(uuid())
  ownerId  String
  owner    User     @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  balance  Decimal  @default(0) @db.Decimal(14, 2)
  currency String   @default("IDR")

  reservations Reservation[]

  ledger  LedgerTransaction[]
  payouts PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, tenantId, currency])
  @@index([tenantId])
  @@index([ownerId])
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model LedgerTransaction {
  id             String         @id @default(uuid())
  category       LedgerCategory
  direction      LedgerDirection
  amount         Decimal        @db.Decimal(14, 2)
  currency       String         @default("IDR")
  walletId       String?
  wallet         Wallet?        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  orderId        String?
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payoutId       String?
  payout         PayoutRequest? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  refundId       String?
  refund         Refund?        @relation(fields: [refundId], references: [id], onDelete: Restrict)
  earningId      String?
  earning        CreatorEarning? @relation(fields: [earningId], references: [id], onDelete: Restrict)
  reversalOfId   String?        @unique
  reversalOf     LedgerTransaction? @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     LedgerTransaction? @relation("LedgerReversal")
  idempotencyKey String         @unique
  description    String?
  createdById    String?
  traceId        String?
  createdAt      DateTime       @default(now())

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([payoutId])
  @@index([refundId])
  @@index([earningId])
  @@index([category, createdAt])
}

model PayoutRequest {
  id              String       @id @default(uuid())
  creatorId       String
  creator         User         @relation("PayoutCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  holdWindow      HoldWindow?
  walletId        String
  wallet          Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amount          Decimal      @db.Decimal(14, 2)
  destinationInfo Json
  status          PayoutStatus @default(REQUESTED)
  requestedAt     DateTime     @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  evidenceUrl     Json?
  rejectionReason String?      @db.Text
  paidAt          DateTime?

  ledger LedgerTransaction[]

  @@index([tenantId, status])
  @@index([creatorId, status])
  @@index([status, requestedAt])
}

model Refund {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  amount          Decimal       @db.Decimal(12, 2)
  reason          String        @db.Text
  status          RefundStatus  @default(REQUESTED)
  requestedById   String
  requestedBy     User          @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?       @db.Text
  processedAt     DateTime?
  evidenceUrl     Json?
  createdAt       DateTime      @default(now())

  ledger LedgerTransaction[]

  @@index([orderId])
  @@index([paymentIntentId, status])
  @@index([status, createdAt])
}

model AICreditPackage {
  id           String  @id @default(uuid())
  name         String
  credits      Int
  price        Decimal @db.Decimal(12, 2)
  currency     String  @default("IDR")
  bonusCredits Int     @default(0)
  active       Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model AICreditWallet {
  id                String @id @default(uuid())
  userId            String @unique
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Int    @default(0)
  reserved          Int    @default(0)
  lifetimeEarned    Int    @default(0)
  lifetimePurchased Int    @default(0)
  lifetimeSpent     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AICreditLedgerEntry {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AICreditEntryType
  amount         Int
  balanceAfter   Int
  sourceType     String
  sourceId       String?
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
}

// -----------------------------------------------------------------------------
// Phase 5 credit loop
// -----------------------------------------------------------------------------

model VirtualCompany {
  id          String                 @id @default(uuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  scenarioSlug String
  startDate   DateTime
  endDate     DateTime
  status      SimulatorCompanyStatus @default(ACTIVE)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  journalEntries JournalEntry[]
  ledgers        Ledger[]
  statements     FinancialStatement[]

  @@index([tenantId, ownerId])
  @@index([scenarioSlug])
}

enum SimulatorCompanyStatus {
  ACTIVE
  CLOSED
}

model JournalEntry {
  id           String          @id @default(uuid())
  companyId    String
  company      VirtualCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date         DateTime
  debitAccount String
  creditAccount String
  amount       Decimal         @db.Decimal(14, 2)
  memo         String?
  createdAt    DateTime        @default(now())

  @@index([companyId, date])
}

model Ledger {
  id         String         @id @default(uuid())
  companyId  String
  company    VirtualCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountName String
  period      String
  debitTotal  Decimal        @db.Decimal(14, 2) @default(0)
  creditTotal Decimal        @db.Decimal(14, 2) @default(0)
  balance     Decimal        @db.Decimal(14, 2) @default(0)
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, accountName, period])
}

model FinancialStatement {
  id            String                @id @default(uuid())
  companyId     String
  company       VirtualCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period        String
  statementType FinancialStatementType
  data          Json
  snapshotHash  String
  createdAt     DateTime              @default(now())

  @@unique([companyId, period, statementType])
}

enum FinancialStatementType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
}

// -----------------------------------------------------------------------------
// Phase 5 credit loop
// -----------------------------------------------------------------------------

model CreditPackage {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  creditAmount Decimal  @db.Decimal(14, 2)
  priceAmount  Decimal  @db.Decimal(14, 2)
  priceCurrency String  @default("IDR")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]  @relation("OrderCreditPackage")
}

enum ReservationPurpose {
  PURCHASE_CREDITS
  PURCHASE_CLASS
  PAYOUT
}

enum ReservationStatus {
  PENDING
  COMMITTED
  RELEASED
  EXPIRED
}

model Reservation {
  id             String              @id @default(uuid())
  idempotencyKey String              @unique
  userId         String
  walletId       String
  amount         Decimal             @db.Decimal(14, 2)
  currency       String              @default("IDR")
  purpose        ReservationPurpose
  referenceId    String?
  status         ReservationStatus   @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  committedAt    DateTime?
  releasedAt     DateTime?

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet         Wallet  @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([expiresAt])
}

model HoldWindow {
  id          String   @id @default(uuid())
  payoutId    String   @unique
  payout      PayoutRequest @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  releaseAt   DateTime
  released    Boolean  @default(false)
  releasedAt  DateTime?
  openRefunds Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([releaseAt, released])
}

model RevenueShareRule {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformFeePct Decimal  @db.Decimal(5, 2)
  creatorPct     Decimal  @db.Decimal(5, 2)
  effectiveFrom  DateTime @default(now())
  effectiveUntil DateTime?

  @@index([tenantId, effectiveFrom])
}

// -----------------------------------------------------------------------------
// Phase 2 personalization
// -----------------------------------------------------------------------------

model AdaptivePolicy {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  nextActivityId String?
  rationale      Json
  appliedAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt])
}

enum SkillNodeState {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  MASTERED
}

model SkillNode {
  id        String         @id @default(cuid())
  userId    String
  topicId   String
  state     SkillNodeState
  progress  Float          @default(0)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, state])
}

model EventLog {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      EventAction
  entityId    String?
  metadata    Json?
  piiRedacted Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

enum EventAction {
  LESSON_COMPLETED
  QUIZ_SUBMITTED
  PURCHASE_COMPLETED
  PAYOUT_RELEASED
  BADGE_ISSUED
}

model MasterySnapshot {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  score      Float
  attempts   Int
  snapshotAt DateTime @default(now())

  @@index([userId, snapshotAt])
  @@index([topicId, snapshotAt])
}

model EngagementMetric {
  id          String            @id @default(uuid())
  cohortId    String
  window      EngagementWindow
  uniqueUsers Int
  totalEvents Int
  createdAt   DateTime          @default(now())

  @@unique([cohortId, window, createdAt])
  @@index([cohortId, window])
}

enum EngagementWindow {
  DAILY
  WEEKLY
  MONTHLY
}

model CreatorOutcomeMetric {
  id             String   @id @default(uuid())
  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  windowStart    DateTime
  windowEnd      DateTime
  salesCount     Int      @default(0)
  completionRate Float    @default(0)
  satisfaction   Float    @default(0)
  totalRevenue   Decimal  @db.Decimal(14, 2) @default(0)
  createdAt      DateTime @default(now())

  @@index([creatorId, windowStart])
}

model RateLimit {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([userId, scope, windowStart])
  @@index([scope, windowStart])
}

model BackupRecord {
  id          String       @id @default(uuid())
  tag         String       @unique
  sizeBytes   BigInt
  checksum    String
  storageUri  String
  status      BackupStatus  @default(PENDING)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  restoredAt  DateTime?

  @@index([status, startedAt])
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  RESTORED
}
