# =================================================================
# REDUCERA — Production environment
# Salin file ini ke .env lalu isi semua secret. Jangan commit .env.
# =================================================================

# ---- Image tag ----
# Untuk rollback, cukup ganti tag ini dan redeploy.
IMAGE_TAG=1.0.0

# ---- Environment ----
NODE_ENV=production

# ---- Postgres ----
# WAJIB diganti untuk production!
POSTGRES_USER=reducera_prod
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password_min_24_chars
POSTGRES_DB=reducera

# ---- Public URLs (dipakai Nginx & services) ----
PUBLIC_API_URL=https://reducera.example.com/api/v1
PUBLIC_AI_URL=https://reducera.example.com/ai/v1
PUBLIC_WEB_URL=https://reducera.example.com
PUBLIC_ADMIN_URL=https://reducera.example.com/admin

# ---- Nginx ports ----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443