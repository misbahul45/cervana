# =================================================================
# CERVANA — Nginx production SSL snippet
# Uncomment di nginx.conf setelah setup certbot / Let's Encrypt.
#
# Cara setup SSL dengan certbot (Let's Encrypt):
#   1. certbot certonly --webroot -w /var/www/html \
#        -d cervana.example.com -d api.cervana.example.com
#   2. Letakkan cert di ./nginx/certs/cervana.example.com/
#   3. Aktifkan include /etc/nginx/conf.d/01-ssl.conf di nginx.conf
# =================================================================

# Redirect HTTP -> HTTPS
server {
    listen 80;
    server_name cervana.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cervana.example.com;

    ssl_certificate     /etc/nginx/certs/cervana.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/cervana.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # HSTS
    add_header Strict-Transport-Security "max-age=63072000" always;

    # Cache SSL session
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Pakai semua lokasi dari main nginx.conf
    # (lihat server block di nginx.conf — semua location di-share via
    # /api/, /ai/, /admin/, /)
    location / {
        proxy_pass http://cervana_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }

    location /api/ {
        proxy_pass http://cervana_api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ai/ {
        proxy_pass http://cervana_ai_api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering    off;
        proxy_read_timeout 600s;
    }

    location /admin {
        proxy_pass http://cervana_admin;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /admin/ {
        proxy_pass http://cervana_admin/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}